---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import Card from '@/components/ui/card.astro';
import Badge from '@/components/ui/badge.astro';
import Button from '@/components/ui/button.astro';
import Icon from '@/components/Icon.astro';
import { siteConfig, getAllBlogPosts } from '@/lib/ffc-config';

const posts = getAllBlogPosts();
const featuredPost = posts[0];
const recentPosts = posts.slice(1);

const categories = Array.from(new Set(posts.map((p) => p.category)));

function formatDate(dateStr: string, opts: Intl.DateTimeFormatOptions) {
  return new Date(dateStr).toLocaleDateString('en-IN', opts);
}
---

<div class="min-h-screen bg-white">
  <Header />

  {/* Hero Section */}
  <section class="pt-24 pb-12 bg-gradient-to-br from-amber-50 via-orange-50 to-amber-100">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto">
        <Badge class="bg-amber-100 text-amber-800 mb-4">Our Blog</Badge>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Celebration Ideas & Inspiration
        </h1>
        <p class="text-lg text-gray-600">
          Discover tips, guides, and ideas for planning the perfect celebration in Vadodara.
          From birthday surprises to romantic proposals, we've got you covered.
        </p>
      </div>
    </div>
  </section>

  {/* Category Filter */}
  <section class="py-6 border-b">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap justify-center gap-2">
        <Badge variant="outline" class="cursor-pointer hover:bg-amber-50 px-4 py-2">
          All Posts
        </Badge>
        {categories.map((category) => (
          <Badge variant="outline" class="cursor-pointer hover:bg-amber-50 px-4 py-2">
            {category}
          </Badge>
        ))}
      </div>
    </div>
  </section>

  {/* Featured Post */}
  <section class="py-12">
    <div class="container mx-auto px-4">
      <a href={`/blog/${featuredPost.slug}`}>
        <Card class="overflow-hidden hover:shadow-xl transition-shadow duration-300 group">
          <div class="grid md:grid-cols-2 gap-0">
            <div class="relative h-64 md:h-auto">
              <img
                src={featuredPost.coverImage}
                alt={featuredPost.title}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <Badge class="absolute top-4 left-4 bg-amber-500">Featured</Badge>
            </div>
            <Card slot="content" class="p-8 flex flex-col justify-center border-0 shadow-none">
              <Badge variant="outline" class="w-fit mb-4">
                {featuredPost.category}
              </Badge>
              <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 group-hover:text-amber-600 transition-colors">
                {featuredPost.title}
              </h2>
              <p class="text-gray-600 mb-6 line-clamp-3">
                {featuredPost.excerpt}
              </p>
              <div class="flex items-center gap-4 text-sm text-gray-500 mb-6">
                <span class="flex items-center gap-1">
                  <Icon name="calendar" class="w-4 h-4" />
                  {formatDate(featuredPost.publishedAt, { day: 'numeric', month: 'short', year: 'numeric' })}
                </span>
                <span class="flex items-center gap-1">
                  <Icon name="clock" class="w-4 h-4" />
                  {featuredPost.readTime} read
                </span>
              </div>
              <Button class="w-fit bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-700 hover:to-orange-700">
                Read Article <Icon name="arrow-right" class="w-4 h-4 ml-2" />
              </Button>
            </Card>
          </div>
        </Card>
      </a>
    </div>
  </section>

  {/* All Posts Grid */}
  <section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-8">Latest Articles</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentPosts.map((post) => (
          <a href={`/blog/${post.slug}`}>
            <Card class="overflow-hidden h-full hover:shadow-lg transition-shadow duration-300 group">
              <div class="relative h-48">
                <img
                  src={post.coverImage}
                  alt={post.title}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <Badge class="absolute top-3 left-3 bg-amber-500">
                  {post.category}
                </Badge>
              </div>
              <Card slot="content" class="p-5 border-0 shadow-none">
                <h3 class="font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-amber-600 transition-colors">
                  {post.title}
                </h3>
                <p class="text-sm text-gray-600 mb-4 line-clamp-2">
                  {post.excerpt}
                </p>
                <div class="flex items-center justify-between text-xs text-gray-500">
                  <span class="flex items-center gap-1">
                    <Icon name="calendar" class="w-3 h-3" />
                    {formatDate(post.publishedAt, { day: 'numeric', month: 'short' })}
                  </span>
                  <span class="flex items-center gap-1">
                    <Icon name="clock" class="w-3 h-3" />
                    {post.readTime}
                  </span>
                </div>
              </Card>
            </Card>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="py-16 bg-gradient-to-r from-amber-600 to-orange-600">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">
        Ready to Plan Your Celebration?
      </h2>
      <p class="text-amber-100 mb-8 max-w-2xl mx-auto">
        Turn your special moments into unforgettable memories at Friends Factory Cafe,
        Vadodara's premier rooftop celebration venue.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" class="bg-white text-amber-600 hover:bg-amber-50" as="a" href="/packages">
          View Packages
        </Button>
        <Button
          size="lg"
          class="bg-green-500 hover:bg-green-600 text-white"
          as="a"
          href={`https://wa.me/${siteConfig.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book on WhatsApp
        </Button>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
</div>
