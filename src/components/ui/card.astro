---
import { cn } from '@/lib/utils';

export interface Props {
  class?: string;
  as?: 'div';
  slot?: 'header' | 'title' | 'description' | 'action' | 'content' | 'footer' | 'root';
  [key: string]: any;
}

const { class: className, slot: variant = 'root', ...rest } = Astro.props;

const variantClasses: Record<string, string> = {
  root: 'bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm',
  header:
    '@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6',
  title: 'leading-none font-semibold',
  description: 'text-muted-foreground text-sm',
  action: 'col-start-2 row-span-2 row-start-1 self-start justify-self-end',
  content: 'px-6',
  footer: 'flex items-center px-6 [.border-t]:pt-6',
};

const dataSlot: Record<string, string> = {
  root: 'card',
  header: 'card-header',
  title: 'card-title',
  description: 'card-description',
  action: 'card-action',
  content: 'card-content',
  footer: 'card-footer',
};
---
{/*
  Every "part" of a card (header/title/description/action/content/footer) is
  written as its own <Card slot="X"> nested inside the root <Card>. Astro's
  compiler intercepts that slot="X" attribute and projects the content into
  a <slot name="X"> on the PARENT - it never reaches this component as a
  prop unless this template declares a matching named slot. Previously this
  only rendered <slot /> (the unnamed default), so every slot="X" child was
  silently dropped: no error, just missing content. Declaring all of them
  here (plus the unnamed one, for simple non-slotted usage) fixes every
  usage across the site in one place instead of patching each call site.
*/}
<div data-slot={dataSlot[variant]} class={cn(variantClasses[variant], className)} {...rest}>
  <slot name="header" />
  <slot name="title" />
  <slot name="description" />
  <slot name="action" />
  <slot name="content" />
  <slot />
  <slot name="footer" />
</div>
