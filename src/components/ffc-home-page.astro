<script>
  // Hero slider auto-advance
  function setupHeroSlider(wrapper: HTMLElement) {
    const section = wrapper.closest('section');
    if (!section) return;
    const slides = Array.from(section.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(section.querySelectorAll<HTMLElement>('[data-hero-dot]'));
    if (slides.length === 0) return;
    let current = 0;

    function show(index: number) {
      current = index;
      slides.forEach((slide, i) => {
        slide.style.opacity = i === index ? '1' : '0';
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-white', i === index);
        dot.classList.toggle('w-8', i === index);
        dot.classList.toggle('bg-white/50', i !== index);
        dot.classList.toggle('w-3', i !== index);
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.dataset.index || 0);
        show(idx);
      });
    });

    setInterval(() => {
      show((current + 1) % slides.length);
    }, 5000);
  }

  document.querySelectorAll<HTMLElement>('[data-hero-slider]').forEach(setupHeroSlider);

  // Reviews carousel
  function setupReviewsCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-reviews-track]');
    const leftBtn = root.querySelector<HTMLElement>('[data-scroll-left]');
    const rightBtn = root.querySelector<HTMLElement>('[data-scroll-right]');
    if (!track) return;

    const scrollAmount = 232; // card width (220px) + gap (12px)

    leftBtn?.addEventListener('click', () => {
      track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });
    rightBtn?.addEventListener('click', () => {
      track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-reviews-carousel]').forEach(setupReviewsCarousel);

  // Gallery filters + video hover-autoplay
  function setupGallery(section: HTMLElement) {
    const filterBtns = section.querySelectorAll<HTMLElement>('[data-filter-btn]');
    const items = section.querySelectorAll<HTMLElement>('[data-gallery-item]');

    function applyFilter(filter: string) {
      items.forEach((item) => {
        const type = item.dataset.type;
        const visible = filter === 'all' || type === filter;
        item.classList.toggle('hidden', !visible);
      });

      filterBtns.forEach((btn) => {
        const isActive = btn.dataset.filter === filter;
        btn.classList.toggle('bg-amber-500', isActive);
        btn.classList.toggle('hover:bg-amber-600', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('border-amber-300', !isActive);
        btn.classList.toggle('text-amber-700', !isActive);
        btn.classList.toggle('hover:bg-amber-50', !isActive);
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => applyFilter(btn.dataset.filter || 'all'));
    });

    section.querySelectorAll<HTMLVideoElement>('[data-hover-video]').forEach((video) => {
      video.addEventListener('mouseenter', () => video.play());
      video.addEventListener('mouseleave', () => {
        video.pause();
        video.currentTime = 0;
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-home-gallery]').forEach(setupGallery);
</script>
