---
<div class="min-h-screen bg-white">
  <Header />

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-amber-600 via-orange-500 to-amber-700 text-white overflow-hidden">
    <!-- Background Image Slider -->
    <div class="absolute inset-0" data-hero-slider>
      {heroSlides.map((slide, index) => (
        <div
          class="absolute inset-0 transition-opacity duration-1000"
          data-hero-slide
          data-index={index}
          style={index === 0 ? 'opacity:1' : 'opacity:0'}
        >
          <img
            src={slide.src}
            alt={slide.alt}
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
      ))}
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/30 to-transparent"></div>

    <!-- Slide Indicators -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-20" data-hero-dots>
      {heroSlides.map((_, index) => (
        <button
          type="button"
          data-hero-dot
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
          class={`h-3 rounded-full transition-all ${index === 0 ? 'bg-white w-8' : 'bg-white/50 w-3'}`}
        ></button>
      ))}
    </div>

    <div class="container mx-auto px-4 py-20 md:py-28 relative">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="text-center lg:text-left">
          <Badge class="mb-6 bg-white/20 text-white border-white/30 text-sm px-4 py-1">
            <Icon name="sparkles" class="h-4 w-4 mr-2" /> Couples Only Experience in Vadodara
          </Badge>
          <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight font-serif">
            Friends Factory Cafe
          </h1>
          <p class="text-xl md:text-2xl mb-4 text-white/90 max-w-2xl">
            {siteConfig.tagline}
          </p>
          <p class="text-lg mb-8 text-white/80 max-w-xl">
            Premium romantic celebration venue for couples. Birthday surprises, candlelight dinners, anniversaries, proposals & more.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a href="/packages">
              <Button size="lg" class="bg-white text-amber-600 hover:bg-amber-50 text-lg px-8 py-6 w-full sm:w-auto">
                <Icon name="gift" class="h-5 w-5 mr-2" />
                View Packages
              </Button>
            </a>
            <a href={`tel:${siteConfig.phone}`}>
              <Button size="lg" class="bg-green-600 hover:bg-green-700 text-white text-lg px-8 py-6 w-full sm:w-auto">
                <Icon name="phone" class="h-5 w-5 mr-2" />
                {siteConfig.phone}
              </Button>
            </a>
          </div>

          <div class="mt-10 flex flex-wrap justify-center lg:justify-start gap-4 text-sm md:text-base">
            <span class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full">
              <Icon name="shield" class="h-4 w-4" /> 100% Private
            </span>
            <span class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full">
              <Icon name="star" class="h-4 w-4" /> 4.9★ Rated
            </span>
            <span class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full">
              <Icon name="users" class="h-4 w-4" /> 3000+ Couples
            </span>
          </div>
        </div>

        <!-- Hero Booking Form -->
        <div class="hidden lg:block">
          <BookingForm variant="hero" />
        </div>
      </div>
    </div>
  </section>

  <!-- Mobile Booking Form -->
  <section class="lg:hidden bg-amber-50 py-8">
    <div class="container mx-auto px-4">
      <BookingForm />
    </div>
  </section>

  <!-- Packages Section -->
  <section class="py-12 md:py-20 bg-gradient-to-b from-amber-50 to-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-8 md:mb-16">
        <Badge class="mb-4 bg-amber-100 text-amber-700 border-amber-200">
          Our Packages
        </Badge>
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 font-serif">
          Our Romantic Celebration Packages
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-sm md:text-base">
          8 unique romantic setups designed to make your celebration unforgettable
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-6">
        {packages.map((pkg, index) => (
          <a href={`/packages/${pkg.slug}`}>
            <Card class="h-full hover:shadow-xl transition-all hover:-translate-y-1 border-amber-100 group overflow-hidden">
              <div class="aspect-square bg-gradient-to-br from-amber-100 to-orange-100 relative overflow-hidden">
                <img
                  src={pkg.thumbnail}
                  alt={pkg.name}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <Badge class="absolute top-2 left-2 bg-amber-600 text-white text-xs">
                  Setup {index + 1}
                </Badge>
              </div>
              <Card slot="content" class="p-2 md:p-4">
                <h3 class="font-semibold text-sm md:text-lg mb-1 group-hover:text-amber-600 transition-colors line-clamp-2">
                  {pkg.name}
                </h3>
                <p class="text-gray-600 text-xs md:text-sm line-clamp-2 mb-2 hidden md:block">
                  {pkg.shortDescription}
                </p>
                <p class="text-base md:text-xl font-bold text-amber-600">
                  {formatPrice(pkg.price)}
                </p>
              </Card>
            </Card>
          </a>
        ))}
      </div>

      <div class="text-center mt-6 md:mt-10">
        <a href="/packages">
          <Button size="lg" class="bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-700 hover:to-orange-700 text-white">
            View All Packages <Icon name="arrow-right" class="h-5 w-5 ml-2" />
          </Button>
        </a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <Badge class="mb-4 bg-amber-100 text-amber-700 border-amber-200">
          Our Services
        </Badge>
        <h2 class="text-3xl md:text-4xl font-bold mb-4 font-serif">
          Perfect For Every Celebration
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          From intimate candlelight dinners to grand proposals, we create magical moments for every special occasion.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {serviceCategories.map((service) => (
          <Card class="h-full border-amber-100">
            <Card slot="content" class="p-4 md:p-6 text-center">
              <div class="text-3xl md:text-4xl mb-3 md:mb-4">{service.emoji}</div>
              <h3 class="font-semibold text-sm md:text-lg mb-1 md:mb-2 line-clamp-2">
                {service.name}
              </h3>
              <p class="text-gray-600 text-xs md:text-sm line-clamp-2 hidden md:block">
                {service.description}
              </p>
            </Card>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience Features -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <Badge class="mb-4 bg-amber-100 text-amber-700 border-amber-200">
          What You Get
        </Badge>
        <h2 class="text-3xl md:text-4xl font-bold mb-4 font-serif">
          The Complete Experience
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {experienceFeatures.map((feature) => (
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-amber-100 flex items-center justify-center mx-auto mb-4">
              <Icon name={feature.icon} class="h-8 w-8 text-amber-600" />
            </div>
            <h3 class="font-semibold text-lg mb-2">{feature.title}</h3>
            <p class="text-gray-600 text-sm">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Menu Preview -->
  <section class="py-20 bg-gradient-to-br from-gray-900 to-gray-800 text-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <Badge class="mb-4 bg-amber-500/20 text-amber-400 border-amber-500/30">
            Our Menu
          </Badge>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 font-serif">
            Curated Café-Style Delicacies
          </h2>
          <p class="text-gray-300 mb-8">
            Crafted for Romantic Dates & Private Celebrations
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-amber-500/20 flex items-center justify-center flex-shrink-0">
                <Icon name="wine" class="h-5 w-5 text-amber-400" />
              </div>
              <div>
                <h4 class="font-semibold">Welcome Drink</h4>
                <p class="text-gray-400 text-sm">A refreshing welcome to begin your romantic experience</p>
              </div>
            </div>

