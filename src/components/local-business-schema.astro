---
import { SEO_CONFIG } from '@/lib/seo-config';

export interface Props {
  serviceName?: string;
  description?: string;
  areaServed?: string;
}

const { serviceName, description, areaServed } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: serviceName || SEO_CONFIG.siteName,
  description: description || `${SEO_CONFIG.niche} in ${SEO_CONFIG.location}. Professional services by ${SEO_CONFIG.siteName}.`,
  url: SEO_CONFIG.siteUrl,
  telephone: SEO_CONFIG.phone,
  areaServed: {
    '@type': 'Place',
    name: areaServed || SEO_CONFIG.location,
  },
  serviceArea: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      addressLocality: areaServed || SEO_CONFIG.location,
    },
  },
  sameAs: [SEO_CONFIG.siteUrl],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
