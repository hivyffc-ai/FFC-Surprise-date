---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import FFCServiceCategoryPage from '@/components/ffc-service-category-page.astro';
import FFCAreaPage from '@/components/ffc-area-page.astro';
import FFCKeywordPage from '@/components/ffc-keyword-page.astro';
import {
  serviceCategories,
  vadodaraAreas as areasList,
  getServiceBySlug,
  getAreaBySlug,
  siteConfig,
  packages,
  type ServiceCategory,
  type ServiceKeyword,
} from '@/lib/ffc-config';

const startingPrice = Math.min(...packages.map((p) => p.price));

export const prerender = true;

export function getStaticPaths() {
  const paths: { params: { slug: string } }[] = [];

  for (const service of serviceCategories) {
    paths.push({ params: { slug: service.slug } });

    for (const keyword of service.keywords) {
      paths.push({ params: { slug: keyword.slug } });
    }
  }

  for (const area of areasList) {
    paths.push({ params: { slug: area.slug } });
  }

  return paths;
}

const { slug } = Astro.params;

const service = serviceCategories.find((s) => s.slug === slug);
const area = areasList.find((a) => a.slug === slug);

let keyword: ServiceKeyword | undefined;
let parentService: ServiceCategory | undefined;

if (!service && !area) {
  for (const s of serviceCategories) {
    const kw = s.keywords.find((k) => k.slug === slug);
    if (kw) {
      keyword = kw;
      parentService = s;
      break;
    }
  }
}

if (!service && !area && !keyword) {
  return Astro.redirect('/', 302);
}

let title = '';
let description = '';
let keywordsList: string[] = [];
let pageName = '';

if (service) {
  title = service.metaTitle;
  description = service.metaDescription;
  keywordsList = [service.name, `${service.name} Vadodara`];
  pageName = service.name;
} else if (area) {
  title = area.uniqueContent?.heroSubtitle || `${area.name} Celebration Venue | ${siteConfig.name}`;
  description = area.uniqueContent?.introduction || `Best private romantic celebration venue in ${area.name}, Vadodara.`;
  keywordsList = [`${area.name} celebration`, `${area.name} romantic cafe`];
  pageName = `Celebrations in ${area.name}`;
} else if (keyword) {
  title = keyword.metaTitle;
  description = keyword.metaDescription;
  keywordsList = [keyword.title, `${keyword.title} Vadodara`];
  pageName = keyword.title;
}

const canonicalUrl = `${siteConfig.website}/${slug}`;

// GEO: concrete, extractable facts (price, provider, area served) for this
// page's specific service - not the sitewide LocalBusiness schema alone.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: pageName,
  description,
  provider: {
    '@type': 'LocalBusiness',
    name: siteConfig.name,
    telephone: siteConfig.phone,
    address: siteConfig.address,
  },
  areaServed: area ? area.name : siteConfig.city,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'INR',
    price: startingPrice,
    availability: 'https://schema.org/InStock',
    url: canonicalUrl,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.website },
    ...(keyword && parentService
      ? [
          { '@type': 'ListItem', position: 2, name: parentService.name, item: `${siteConfig.website}/${parentService.slug}` },
          { '@type': 'ListItem', position: 3, name: pageName, item: canonicalUrl },
        ]
      : [{ '@type': 'ListItem', position: 2, name: pageName, item: canonicalUrl }]),
  ],
};
---
<BaseLayout
  title={title}
  description={description}
  keywords={keywordsList}
  canonicalPath={`/${slug}`}
  noTemplate={true}
  extraJsonLd={[serviceSchema, breadcrumbSchema]}
>
  {
    service && (
      <FFCServiceCategoryPage service={service} />
    )
  }
  {
    area && (
      <FFCAreaPage area={area} />
    )
  }
  {
    keyword && parentService && (
      <FFCKeywordPage keyword={keyword} service={parentService} />
    )
  }
</BaseLayout>
