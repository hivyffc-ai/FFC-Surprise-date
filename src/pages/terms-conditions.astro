---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/lib/ffc-config';
---
<BaseLayout
  title={`Terms & Conditions — ${siteConfig.name}`}
  description={`Terms and conditions for booking at ${siteConfig.name}. Cancellation policy, rescheduling rules, payment terms and venue guidelines.`}
  canonicalPath="/terms-conditions"
  noTemplate={false}
>
  <div class="min-h-screen bg-white">
    <Header />
    <div class="container mx-auto px-4 py-16 max-w-3xl">
      <h1 class="text-3xl font-bold text-gray-900 mb-8 font-serif">Terms & Conditions</h1>
      <p class="text-sm text-gray-500 mb-8">Last updated: January 2025</p>

      <div class="prose prose-gray max-w-none space-y-6 text-gray-700">
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-3">1. Booking & Confirmation</h2>
          <p>A booking is confirmed only after you receive a confirmation message from our team on WhatsApp. <strong>Full payment is required to confirm the booking.</strong></p>
        </section>
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-3">2. Cancellation Policy</h2>
          <p><strong>No Refund Policy:</strong> All bookings are non-refundable. Once your booking is confirmed, cancellation will not entitle you to a refund of any advance payment made.</p>
        </section>
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-3">3. Rescheduling Policy</h2>
          <p>Your event may be rescheduled provided that:</p>
          <ul class="list-disc ml-6 space-y-1">
            <li>Rescheduling is requested at least <strong>24 hours before</strong> your booked slot.</li>
            <li>The new date must be within <strong>one month</strong> from the original booking date.</li>
            <li>Rescheduling is subject to slot availability.</li>
            <li>Only one rescheduling is permitted per booking.</li>
          </ul>
        </section>
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-3">4. Duration & Venue Access</h2>
          <p>Each package includes 3 hours of exclusive venue access. Additional time beyond the booked slot is not guaranteed and is subject to availability at extra cost.</p>
        </section>
      </div>
    </div>
    <Footer />
  </div>
</BaseLayout>
